# Datenbank (siehe ADR-004: MySQL)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Geheimer Schlüssel, mit dem Tutorio seine eigenen JWTs signiert (HS256).
# Langer, zufälliger String — z. B. mit: php -r "echo bin2hex(random_bytes(32));"
TUTORIO_JWT_SECRET=change_me_to_a_long_random_string
# Gültigkeitsdauer der Tutorio-Session in Sekunden (hier: 2 Stunden)
TUTORIO_JWT_TTL=7200

# Nur für lokales Testen ohne echtes Digikabu — siehe stubDigikabuToken()
# in AuthService.php. Vor echtem Einsatz entfernen/auf false setzen!
AUTH_STUB_MODE=true

# Digikabu (Schulverwaltungssystem, siehe Kapitel 3.2)
DIGIKABU_BASE_URL=https://digikabu.example-schule.de
# Gemeinsames Secret zur Prüfung der Digikabu-Signatur (HS256).
# OFFENER PUNKT: muss von der Schul-IT/Digikabu-Betreiber bereitgestellt werden.
DIGIKABU_SHARED_SECRET=change_me_ask_digikabu_admin
